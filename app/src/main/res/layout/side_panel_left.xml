<?xml version="1.0" encoding="UTF-8"?>
<com.firebirdberlin.nightdream.ui.SidePanel
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/side_menu_left"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="@drawable/side_panel_left_bg"
    app:alignItems="center"
    app:dividerDrawable="@drawable/divider"
    app:flexDirection="column"
    app:flexWrap="wrap"
    android:visibility="invisible"
    app:justifyContent="space_around"
    app:side="left"
    app:showDividerVertical="none">

        <ImageView
            android:id="@+id/settings_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="@string/preferences"
            android:focusable="true"
            android:onClick="onSettingsClick"
            android:padding="5dp"
            app:srcCompat="@drawable/ic_settings" />

        <ImageView
            android:id="@+id/alarm_clock_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="@string/alarm"
            android:focusable="true"
            android:onClick="onAlarmClockClick"
            android:padding="5dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_alarm_clock_icon" />

        <ImageView
            android:id="@+id/icon_weather_forecast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="@string/weather"
            android:focusable="true"
            android:onClick="onWeatherForecastClick"
            android:padding="5dp"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_cloud" />

        <ImageView
            android:id="@+id/torch_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="@string/smart_home"
            android:focusable="true"
            android:onClick="onBulbClick"
            android:padding="5dp"
            app:srcCompat="@drawable/ic_lightbulb" />

        <ImageView
            android:id="@+id/radio_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="@string/radio"
            android:focusable="true"
            android:onClick="onRadioClick"
            android:padding="5dp"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_radio" />

</com.firebirdberlin.nightdream.ui.SidePanel>

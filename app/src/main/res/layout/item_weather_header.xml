<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top Row: Date Header + Expand/Collapse Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dateHeaderView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/blue"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Montag, 12. Mai" />

        <TextView
            android:id="@+id/expandIndicatorView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blue"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            tools:text="▼" />

    </LinearLayout>

    <!-- Summary Layout (Visible when collapsed) -->
    <LinearLayout
        android:id="@+id/summaryLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        tools:visibility="visible">

        <!-- Top summary row: Temperature | Precipitation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/summaryTemperatureView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="10°C - 20°C" />

            <TextView
                android:id="@+id/summaryRainView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:singleLine="true"
                tools:text="2.5 mm" />

        </LinearLayout>

        <!-- Bottom summary row: Wind | Humidity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="start|center_vertical">

                <com.firebirdberlin.nightdream.ui.DirectionIconView
                    android:id="@+id/summaryWindDirectionView"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/summaryWindView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    tools:text="3.2 m/s - 6.5 m/s" />

            </LinearLayout>

            <TextView
                android:id="@+id/summaryHumidityView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_humidity"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                tools:text="45 % - 80 %" />

        </LinearLayout>

        <com.firebirdberlin.nightdream.ui.WeatherGraphView
            android:id="@+id/summaryWeatherGraph"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</LinearLayout>

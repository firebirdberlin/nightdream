<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:baselineAligned="false">

    <!-- Section 1: Icon (Left) & Temperature + Description (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/summaryIcon"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="40sp"
            tools:text="m" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/summaryTemperature"
                android:singleLine="true"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="10°C" />

            <TextView
                android:id="@+id/summaryDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="16sp"
                tools:text="Klarer Himmel" />

        </LinearLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.35" />

    <!-- Section 2: Regen (conditional) | Wind | Humidity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Regen (visible only when raining) -->
        <LinearLayout
            android:id="@+id/summaryRainLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/summaryRainIcon"
                android:textColor="@color/weather_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="14sp"
                tools:text="R" />

            <TextView
                android:id="@+id/summaryRainText"
                android:textColor="@color/weather_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:singleLine="true"
                android:textSize="14sp"
                tools:text="0,2 mm" />
        </LinearLayout>

        <!-- Wind -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <com.firebirdberlin.nightdream.ui.DirectionIconView
                android:id="@+id/summaryWindDirection"
                android:layout_width="16dp"
                android:layout_height="16dp" />

            <TextView
                android:id="@+id/summaryWind"
                android:textColor="@color/weather_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:singleLine="true"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="3,6 m/s (3 Bft)" />
        </LinearLayout>

        <!-- Humidity (wrap_content so icon is right next to value) -->
        <TextView
            android:id="@+id/summaryHumidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:drawableStartCompat="@drawable/ic_humidity"
            app:drawableTint="@color/weather_humidity"
            android:textColor="@color/weather_humidity"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="76 %" />

    </LinearLayout>

    <!-- Section 3: Sonnenaufgang (left) | Sonnenuntergang (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Sonnenaufgang -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <!-- body symbol: fixed width, centered, forced text presentation (no color emoji) -->
            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:text="☀︎"
                android:textColor="@color/weather_sun"
                android:textSize="14sp" />

            <!-- arrow: fixed width, centered, so up/down arrows sit at the same x position -->
            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:text="▲︎"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/summarySunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="14sp"
                tools:text="06:52" />
        </LinearLayout>

        <!-- Spacer (Col 2) -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Sonnenuntergang -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <!-- body symbol: fixed width, centered, forced text presentation (no color emoji) -->
            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:text="☀︎"
                android:textColor="@color/weather_sun"
                android:textSize="14sp" />

            <!-- arrow: fixed width, centered, so up/down arrows sit at the same x position -->
            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:text="▼︎"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/summarySunset"
                android:layout_width="wrap_content"
                android:minWidth="64dp"
                android:gravity="start"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="14sp"
                tools:text="16:46" />
        </LinearLayout>

    </LinearLayout>

    <!-- Section 4: Moon rise (left) | Moon phase (center) | Moon set (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Moonrise -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <!-- body symbol: fixed width, centered, forced text presentation (no color emoji) -->
            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:text="☽︎"
                android:textColor="@color/weather_moon"
                android:textSize="14sp" />

            <!-- arrow: fixed width, centered, so up/down arrows sit at the same x position -->
            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:text="▲︎"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/summaryMoonrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="14sp"
                tools:text="21:15" />
        </LinearLayout>

        <!-- Moonphase -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/summaryMoonPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="14sp"
                tools:text="🌑 50%" />
        </LinearLayout>

        <!-- Moonset -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <!-- body symbol: fixed width, centered, forced text presentation (no color emoji) -->
            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:text="☽︎"
                android:textColor="@color/weather_moon"
                android:textSize="14sp" />

            <!-- arrow: fixed width, centered, so up/down arrows sit at the same x position -->
            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:text="▼︎"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/summaryMoonset"
                android:layout_width="wrap_content"
                android:minWidth="64dp"
                android:gravity="start"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="14sp"
                tools:text="07:30" />
        </LinearLayout>

    </LinearLayout>

    <!-- Section 4: Air Quality Container -->
    <FrameLayout
        android:id="@+id/airQualityContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
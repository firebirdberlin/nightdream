<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <import type="com.firebirdberlin.nightdream.Utility"/>
        <variable name="model" type="com.firebirdberlin.nightdream.ui.MediaControlLayout" />
    </data>

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/notification_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:flexDirection="row">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/notify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/notify_smallicon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="4dp"
                    android:src="@{model.smallIcon}"
                    app:layout_constraintBottom_toBottomOf="@+id/notify_text"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/notify_text" />

                <TextView
                    android:id="@+id/notify_appname"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:text="@{model.appName}"
                    android:textColor="@{model.textColor}"
                    android:textSize="8sp"
                    app:layout_constraintStart_toEndOf="@+id/notify_smallicon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/notify_timestamp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:text="@{model.timeStamp}"
                    android:textColor="@{model.textColor}"
                    android:textSize="8sp"
                    app:layout_constraintStart_toEndOf="@+id/notify_appname"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/notify_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@{model.text}"
                    android:textColor="@{model.textColor}"
                    android:textSize="9sp"
                    app:layout_constraintEnd_toStartOf="@+id/notify_largeicon"
                    app:layout_constraintStart_toEndOf="@+id/notify_smallicon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/notify_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@{model.title}"
                    android:textColor="@{model.textColor}"
                    android:textSize="9sp"
                    app:layout_constraintEnd_toStartOf="@+id/notify_largeicon"
                    app:layout_constraintStart_toEndOf="@+id/notify_smallicon"
                    app:layout_constraintTop_toBottomOf="@+id/notify_text" />

                <ImageView
                    android:id="@+id/notify_largeicon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    android:src="@{model.largeIcon}"
                    android:visibility="@{Utility.getVisibility(model.largeIcon)}"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/notify_actions_images"
                    android:layout_width="0dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="6dp"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/notify_largeicon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/notify_title">

                    <ImageView
                        android:id="@+id/notify_actionview1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:onClick="@{Utility.getOnClickListenerOrNull(model.actionIntent, 0)}"
                        android:src="@{Utility.getDrawableOrNull(model.actionImages, 0)}"
                        android:visibility="@{Utility.getVisibility(model.actionImages, 0)}" />

                    <ImageView
                        android:id="@+id/notify_actionview2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:onClick="@{Utility.getOnClickListenerOrNull(model.actionIntent, 1)}"
                        android:src="@{Utility.getDrawableOrNull(model.actionImages, 1)}"
                        android:visibility="@{Utility.getVisibility(model.actionImages, 1)}" />

                    <ImageView
                        android:id="@+id/notify_actionview3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:onClick="@{Utility.getOnClickListenerOrNull(model.actionIntent, 2)}"
                        android:src="@{Utility.getDrawableOrNull(model.actionImages, 2)}"
                        android:visibility="@{Utility.getVisibility(model.actionImages, 2)}" />

                    <ImageView
                        android:id="@+id/notify_actionview4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:onClick="@{Utility.getOnClickListenerOrNull(model.actionIntent, 3)}"
                        android:src="@{Utility.getDrawableOrNull(model.actionImages, 3)}"
                        android:visibility="@{Utility.getVisibility(model.actionImages, 3)}" />

                    <ImageView
                        android:id="@+id/notify_actionview5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:onClick="@{Utility.getOnClickListenerOrNull(model.actionIntent, 4)}"
                        android:src="@{Utility.getDrawableOrNull(model.actionImages, 4)}"
                        android:visibility="@{Utility.getVisibility(model.actionImages, 4)}" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>
    </com.google.android.flexbox.FlexboxLayout>
</layout>